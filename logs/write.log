### 참고 파일 drawer_db/service.py
from .db import connect, exec_script
from .queries import run_all
from .resources import schema_sql, seed_sql


def do_init(db_path: str) -> None:
    import os

    if os.path.exists(db_path):
        os.remove(db_path)

    conn = connect(db_path)
    try:
        exec_script(conn, schema_sql())
    finally:
        conn.close()


def do_seed(db_path: str) -> None:
    conn = connect(db_path)
    try:
        exec_script(conn, seed_sql())
    finally:
        conn.close()


def do_queries(db_path: str) -> str:
    do_init(db_path)
    do_seed(db_path)

    conn = connect(db_path)
    try:
        return run_all(conn)
    finally:
        conn.close()


def do_all(db_path: str) -> str:
    return do_queries(db_path)


### 참고 파일 drawer_db/db.py
import sqlite3

from .errors import DrawerError


def connect(db_path: str) -> sqlite3.Connection:
    try:
        conn = sqlite3.connect(db_path)
        conn.execute("PRAGMA foreign_keys = ON")
        return conn
    except sqlite3.Error as exc:
        raise DrawerError("데이터베이스 연결에 실패했습니다.", hint=str(exc)) from exc


def exec_script(conn: sqlite3.Connection, script_sql: str) -> None:
    try:
        conn.executescript(script_sql)
        conn.commit()
    except sqlite3.Error as exc:
        conn.rollback()
        raise DrawerError("SQL 스크립트 실행에 실패했습니다.", hint=str(exc)) from exc


def run_query(conn: sqlite3.Connection, sql: str) -> tuple[list[str], list[tuple]]:
    try:
        cursor = conn.execute(sql)
        columns = [description[0] for description in cursor.description] if cursor.description else []
        rows = cursor.fetchall()
        return columns, rows
    except sqlite3.Error as exc:
        raise DrawerError("SQL 쿼리 실행에 실패했습니다.", hint=str(exc)) from exc


### 참고 파일 drawer_db/main.py
import sys

from .errors import DrawerError
from .service import do_all, do_init, do_queries, do_seed


def parse_args(argv: list[str]) -> tuple[str, str]:
    default_db_path = "drawer.db"
    valid_commands = {"init", "seed", "queries", "all"}

    if not argv:
        return "all", default_db_path

    first = argv[0]
    if first in valid_commands:
        command = first
        db_path = argv[1] if len(argv) >= 2 else default_db_path
        if len(argv) > 2:
            raise DrawerError(
                "인자가 너무 많습니다.",
                "사용법: python -m drawer_db.main [init|seed|queries|all] [db_path]",
            )
        return command, db_path

    if len(argv) == 1:
        return "all", first

    raise DrawerError(
        "알 수 없는 명령입니다.",
        "사용법: python -m drawer_db.main [init|seed|queries|all] [db_path]",
    )


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv

    try:
        command, db_path = parse_args(args)

        if command == "init":
            do_init(db_path)
        elif command == "seed":
            do_seed(db_path)
        elif command == "queries":
            print(do_queries(db_path))
        elif command == "all":
            print(do_all(db_path))
        else:
            raise DrawerError(
                "지원하지 않는 명령입니다.",
                "init, seed, queries, all 중 하나를 사용하세요.",
            )
        return 0
    except DrawerError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())


