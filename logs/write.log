import sys
import os
from pathlib import Path

try:
    from PIL import Image, ImageDraw, ImageFont
except ImportError:
    print("pip install pillow")
    sys.exit(1)


def find_font():
    candidates = [
        "C:/Windows/Fonts/malgun.ttf",
        "/System/Library/Fonts/AppleSDGothicNeo.ttc",
        "/usr/share/fonts/truetype/nanum/NanumGothic.ttf",
    ]
    for candidate in candidates:
        if os.path.exists(candidate):
            return candidate
    print("한글 폰트를 찾을 수 없습니다. 다음 경로 중 하나에 폰트를 설치하세요:")
    for candidate in candidates:
        print(f"  {candidate}")
    sys.exit(1)


def parse_table_structure(lines):
    # 구분선(---+---) 패턴으로 표 여부와 열 경계 판단
    separator_line = None
    for i, line in enumerate(lines):
        if "---" in line and "|" in line:
            separator_line = i
            break
    
    if separator_line is None:
        return None  # 표가 아님
    
    # 구분선에서 | 위치 찾기
    sep_line = lines[separator_line]
    col_boundaries = [i for i, c in enumerate(sep_line) if c == "|"]
    
    return {"separator_idx": separator_line, "col_boundaries": col_boundaries}


def measure_cell_width(text, font):
    # 셀 텍스트 양쪽 공백 제거 후 너비 측정
    text = text.strip()
    return font.getlength(text) if text else 0


def render_text_file(txt_path, font, font_size):
    # 파일 읽기
    with open(txt_path, "r", encoding="utf-8") as f:
        lines = f.read().rstrip("\n").split("\n")
    
    if not lines:
        return None
    
    font_obj = ImageFont.truetype(font, font_size)
    
    # 레이아웃 계산
    line_height = int(font_obj.size * 1.5)
    padding = 20
    
    # 첫 줄 강조색, 나머지 기본색
    max_width = 0
    for i, line in enumerate(lines):
        width = font_obj.getlength(line)
        max_width = max(max_width, width)
    
    img_width = max_width + 2 * padding
    img_height = len(lines) * line_height + 2 * padding
    
    img = Image.new("RGB", (img_width, img_height), color="#1e1e1e")
    draw = ImageDraw.Draw(img)
    
    # 줄 그리기
    for i, line in enumerate(lines):
        y = padding + i * line_height
        
        # 첫 줄은 강조색, 나머지는 기본색
        if i == 0 and line.startswith("==="):
            color = "#4ec9b0"
        else:
            color = "#d4d4d4"
        
        draw.text((padding, y), line, fill=color, font=font_obj)
    
    return img


def main():
    project_root = Path(__file__).parent.parent
    results_dir = project_root / "results"
    screenshots_dir = results_dir / "screenshots"
    screenshots_dir.mkdir(parents=True, exist_ok=True)
    
    font_path = find_font()
    font_size = 12
    
    created_count = 0
    
    # Q01.txt ~ Q15.txt 처리
    for i in range(1, 16):
        txt_filename = f"Q{i:02d}.txt"
        txt_path = results_dir / txt_filename
        
        if not txt_path.exists():
            continue
        
        img = render_text_file(str(txt_path), font_path, font_size)
        if img:
            png_filename = f"Q{i:02d}.png"
            png_path = screenshots_dir / png_filename
            img.save(str(png_path), "PNG")
            created_count += 1
    
    # all_queries.txt 처리
    all_queries_path = results_dir / "all_queries.txt"
    if all_queries_path.exists():
        img = render_text_file(str(all_queries_path), font_path, font_size)
        if img:
            png_path = screenshots_dir / "all_queries.png"
            img.save(str(png_path), "PNG")
            created_count += 1
    
    print(created_count)


if __name__ == "__main__":
    main()
