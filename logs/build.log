----- build cli.py / 응답 / gpt-5.4 -----
import argparse

from .db import connect
from .queries import all_queries, format_result, get_query, run_query
from .schema import create_schema
from .seed import load_seed


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="python -m book_rental_db.cli",
        description="Book rental database CLI",
    )
    parser.add_argument(
        "--db",
        default="rental.db",
        help="SQLite database file path (default: rental.db)",
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("init", help="Create schema")
    subparsers.add_parser("seed", help="Load sample data")

    query_parser = subparsers.add_parser("query", help="Run one query or list queries")
    query_parser.add_argument(
        "name",
        nargs="?",
        help="Predefined query name to run",
    )
    query_parser.add_argument(
        "--list",
        action="store_true",
        help="List predefined query names",
    )

    subparsers.add_parser("run", help="Create schema, load seed data, and run all queries")

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.command == "query" and args.list:
        for q in all_queries():
            print(f"{q.name}: {q.description}")
        return 0

    conn = connect(args.db)
    try:
        if args.command == "init":
            create_schema(conn)
            print("schema initialized")
            return 0

        if args.command == "seed":
            load_seed(conn)
            print("seed loaded")
            return 0

        if args.command == "query":
            if not args.name:
                parser.error("query command requires NAME unless --list is used")
            q = get_query(args.name)
            columns, rows = run_query(conn, q)
            print(format_result(columns, rows))
            return 0

        if args.command == "run":
            create_schema(conn)
            load_seed(conn)
            for q in all_queries():
                print(f"# {q.name}")
                print(f"# {q.description}")
                columns, rows = run_query(conn, q)
                print(format_result(columns, rows))
            return 0

        parser.error("unknown command")
        return 2
    finally:
        conn.close()
