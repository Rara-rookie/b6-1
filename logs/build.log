----- build db.py / 응답 / gpt-5.4 -----
import sqlite3


def connect(db_path: str) -> sqlite3.Connection:
    conn = sqlite3.connect(db_path)
    conn.execute("PRAGMA foreign_keys=ON")
    return conn


def execute_script(conn: sqlite3.Connection, statements: list[str]) -> None:
    cursor = conn.cursor()
    try:
        for statement in statements:
            text = statement.strip()
            if text:
                cursor.execute(text)
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    finally:
        cursor.close()


def run_select(conn: sqlite3.Connection, sql: str, params: tuple = ()) -> tuple[list[str], list[tuple]]:
    cursor = conn.cursor()
    try:
        cursor.execute(sql, params)
        rows = cursor.fetchall()
        description = cursor.description or []
        columns = [item[0] for item in description]
        return columns, rows
    finally:
        cursor.close()


def run_write(conn: sqlite3.Connection, sql: str, params: tuple = ()) -> int:
    cursor = conn.cursor()
    try:
        cursor.execute(sql, params)
        conn.commit()
        return cursor.rowcount
    except Exception:
        conn.rollback()
        raise
    finally:
        cursor.close()
