\",\n            False,\n        ),\n        Query(\n            \"rental_with_member_book\",\n            \"조인 조회: 대여 기록과 회원명, 책 제목을 함께 조회한다.\",\n            \"\"\"\n            SELECT\n                r.id AS rental_id,\n                m.name AS member_name,\n                b.title AS book_title,\n                r.rented_at,\n                r.due_date,\n                r.returned_at\n            FROM rental AS r\n            INNER JOIN member AS m ON r.member_id = m.id\n            INNER JOIN book AS b ON r.book_id = b.id\n            ORDER BY r.id ASC\n            LIMIT 10\n            \"\"\",\n            False,\n        ),\n        Query(\n            \"books_with_category\",\n            \"조인 조회: 책과 카테고리명을 함께 조회한다.\",\n            \"\"\"\n            SELECT\n                b.id,\n                b.title,\n                b.author,\n                c.name AS category_name\n            FROM book AS b\n            INNER JOIN category AS c ON b.category_id = c.id\n            ORDER BY c.name ASC, b.title ASC\n            LIMIT 10\n            \"\"\",\n            False,\n        ),\n        Query(\n            \"members_without_rentals\",\n            \"조인 조회: 대여 기록이 없는 회원을 LEFT JOIN으로 찾는다.\",\n            \"\"\"\n            SELECT\n                m.id,\n                m.name,\n                m.email\n            FROM member AS m\n            LEFT JOIN rental AS r ON m.id = r.member_id\n            WHERE r.id IS NULL\n            ORDER BY m.id ASC\n            \"\"\",\n            False,\n        ),\n        Query(\n            \"active_rentals_with_category\",\n            \"조인 조회: 현재 대여 중인 도서의 회원, 책, 카테고리를 조회한다.\",\n            \"\"\"\n            SELECT\n                r.id AS rental_id,\n                m.name AS member_name,\n                b.title AS book_title,\n                c.name AS category_name,\n                r.due_date\n            FROM rental AS r\n            INNER JOIN member AS m ON r.member_id = m.id\n            INNER JOIN book AS b ON r.book_id = b.id\n            INNER JOIN category AS c ON b.category_id = c.id\n            WHERE r.returned_at IS NULL\n            ORDER BY r.due_date ASC, r.id ASC\n            \"\"\",\n            False,\n        ),\n        Query(\n            \"rental_count_by_member\",\n            \"집계 조회: 회원별 대여 횟수를 집계한다.\",\n            \"\"\"\n            SELECT\n                m.id,\n                m.name,\n                COUNT(r.id) AS rental_count\n            FROM member AS m\n            LEFT JOIN rental AS r ON m.id = r.member_id\n            GROUP BY m.id, m.name\n            ORDER BY rental_count DESC, m.id ASC\n            \"\"\",\n            False,\n        ),\n        Query(\n            \"book_count_by_category\",\n            \"집계 조회: 카테고리별 도서 수를 집계한다.\",\n            \"\"\"\n            SELECT\n                c.id,\n                c.name,\n                COUNT(b.id) AS book_count\n            FROM category AS c\n            LEFT JOIN book AS b ON c.id = b.category_id\n            GROUP BY c.id, c.name\n            ORDER BY book_count DESC, c.id ASC\n            \"\"\",\n            False,\n        ),\n        Query(\n            \"average_rental_days_by_member\",\n            \"집계 조회: 반납 완료된 대여 기준 회원별 평균 대여 일수를 구한다. (SQLite 전용: JULIANDAY)\",\n            \"\"\"\n            SELECT\n                m.id,\n                m.name,\n                AVG(JULIANDAY(r.returned_at) - JULIANDAY(r.rented_at)) AS avg_rental_days\n            FROM member AS m\n            INNER JOIN rental AS r ON m.id = r.member_id\n            WHERE r.returned_at IS NOT NULL\n            GROUP BY m.id, m.name\n            ORDER BY avg_rental_days DESC, m.id ASC\n            \"\"\",\n            False,\n        ),\n        Query(\n            \"books_above_average_stock\",\n            \"서브쿼리 조회: 전체 평균 재고보다 재고가 많은 책을 찾는다.\",\n            \"\"\"\n            SELECT id, title, stock\n            FROM book\n            WHERE stock > (SELECT AVG(stock) FROM book)\n            ORDER BY stock DESC, id ASC\n            \"\"\",\n            False,\n        ),\n        Query(\n            \"mark_overdue_status\",\n            \"데이터 수정: 연체 중이고 상태가 RENTED인 대여를 OVERDUE로 변경한다. (SQLite 전용: DATE('now'))\",\n            \"\"\"\n            UPDATE rental\n            SET status = 'OVERDUE'\n            WHERE returned_at IS NULL\n              AND due_date < DATE('now')\n              AND status = 'RENTED'\n            \"\"\",\n            True,\n        ),\n        Query(\n            \"close_returned_rentals\",\n            \"데이터 수정: 이미 반납일이 있는 대여의 상태를 RETURNED로 정리한다.\",\n            \"\"\"\n            UPDATE rental\n            SET status = 'RETURNED'\n            WHERE returned_at IS NOT NULL\n              AND status <> 'RETURNED'\n            \"\"\",\n            True,\n        ),\n        Query(\n            \"delete_cancelled_members\",\n            \"데이터 삭제: 대여 기록이 전혀 없고 상태가 CANCELLED인 회원을 삭제한다.\",\n            \"\"\"\n            DELETE FROM member\n            WHERE status = 'CANCELLED'\n              AND id NOT IN (\n                  SELECT DISTINCT member_id\n                  FROM rental\n              )\n            \"\"\",\n            True,\n        ),\n    ]\n\n\ndef get_query(name: str) -> Query:\n    for query in all_queries():\n        if query.name == name:\n            return query\n    raise QueryNotFound(name)\n\n\ndef run_query(conn: sqlite3.Connection, q: Query) -> tuple[list[str], list[tuple]]:\n    if q.is_write:\n        count = run_write(conn, q.sql)\n        return [\"affected_rows\"], [(count,)]\n    return run_select(conn, q.sql)\n\n\ndef format_result(columns: list[str], rows: list[tuple]) -> str:\n    lines = [\",\".join(columns)]\n    for row in rows:\n        values = [\"\" if value is None else str(value) for value in row]\n        lines.append(\",\".join(values))\n    return \"\\n\".join(lines)\n"}
