-- 1. 기본 조회: 현재 등록된 회원을 이름순으로 5명 확인한다.
SELECT id, name, email, joined_at
FROM member
ORDER BY name ASC
LIMIT 5;

-- 2. 기본 조회: 2024년에 가입한 회원만 최근 가입순으로 확인한다.
SELECT id, name, email, joined_at
FROM member
WHERE joined_at >= '2024-01-01'
ORDER BY joined_at DESC
LIMIT 10;

-- 3. 기본 조회: 재고가 3권 이하인 도서를 재고 적은 순으로 확인한다.
SELECT id, title, author, stock
FROM book
WHERE stock <= 3
ORDER BY stock ASC, title ASC
LIMIT 10;

-- 4. 기본 조회: 이름에 '데이터'가 포함된 도서를 제목순으로 확인한다.
SELECT id, title, author, published_date
FROM book
WHERE title LIKE '%데이터%'
ORDER BY title ASC
LIMIT 10;

-- 5. INNER JOIN: 도서와 카테고리를 함께 조회하여 각 도서의 분류를 확인한다.
SELECT b.id, b.title, b.author, c.name AS category_name
FROM book AS b
INNER JOIN category AS c ON b.category_id = c.id
ORDER BY b.id ASC;

-- 6. INNER JOIN: 대여 기록에 회원과 도서 정보를 붙여 최근 대여 내역을 확인한다.
SELECT r.id, m.name AS member_name, b.title AS book_title, r.rented_at, r.due_date, r.returned_at
FROM rental AS r
INNER JOIN member AS m ON r.member_id = m.id
INNER JOIN book AS b ON r.book_id = b.id
ORDER BY r.rented_at DESC
LIMIT 10;

-- 7. INNER JOIN: 특정 카테고리(프로그래밍)에 속한 도서 목록을 확인한다.
SELECT b.id, b.title, b.author, c.name AS category_name
FROM book AS b
INNER JOIN category AS c ON b.category_id = c.id
WHERE c.name = '프로그래밍'
ORDER BY b.title ASC;

-- 8. LEFT JOIN: 아직 대여 이력이 없는 회원도 포함하여 회원별 대여 건수를 확인한다.
SELECT m.id, m.name, COUNT(r.id) AS rental_count
FROM member AS m
LEFT JOIN rental AS r ON m.id = r.member_id
GROUP BY m.id, m.name
ORDER BY rental_count DESC, m.id ASC;

-- 9. 집계: 카테고리별 도서 수를 집계한다.
SELECT c.id, c.name, COUNT(b.id) AS book_count
FROM category AS c
LEFT JOIN book AS b ON c.id = b.category_id
GROUP BY c.id, c.name
ORDER BY book_count DESC, c.id ASC;

-- 10. 집계: 회원별 대여 건수와 반납 완료 건수를 함께 집계한다.
SELECT m.id,
       m.name,
       COUNT(r.id) AS total_rentals,
       SUM(CASE WHEN r.returned_at IS NOT NULL THEN 1 ELSE 0 END) AS returned_rentals
FROM member AS m
LEFT JOIN rental AS r ON m.id = r.member_id
GROUP BY m.id, m.name
ORDER BY total_rentals DESC, m.id ASC;

-- 11. 집계: 카테고리별 평균 도서 재고를 계산한다.
SELECT c.id, c.name, AVG(b.stock) AS avg_stock
FROM category AS c
INNER JOIN book AS b ON c.id = b.category_id
GROUP BY c.id, c.name
ORDER BY avg_stock DESC, c.id ASC;

-- 12. 서브쿼리: 전체 평균 재고보다 재고가 많은 도서를 확인한다.
SELECT id, title, author, stock
FROM book
WHERE stock > (
    SELECT AVG(stock)
    FROM book
)
ORDER BY stock DESC, title ASC;

-- 13. 서브쿼리: 대여 이력이 한 번도 없는 회원을 찾는다.
SELECT id, name, email
FROM member
WHERE id NOT IN (
    SELECT member_id
    FROM rental
)
ORDER BY id ASC;

-- 14. 데이터 수정: 아직 반납되지 않았고 반납 예정일이 지난 대여를 연체 상태로 변경한다.
UPDATE rental
SET status = 'OVERDUE'
WHERE returned_at IS NULL
  AND due_date < DATE('now');

-- 15. 데이터 수정: 특정 도서의 재고를 1권 증가시킨다.
UPDATE book
SET stock = stock + 1
WHERE id = 1;

-- 16. 데이터 삭제: 테스트용으로 추가된 오래된 대여 기록 1건을 삭제한다.
DELETE FROM rental
WHERE id = 10;

-- 17. 인덱스 생성: 회원별 대여 조회가 자주 일어나므로 rental.member_id에 인덱스를 생성한다. -- SQLite 전용 문법 아님
CREATE INDEX IF NOT EXISTS idx_rental_member_id ON rental(member_id);
