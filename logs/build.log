class RentalDBError(Exception):
    def __init__(self, message: str, hint: str | None = None):
        self.message = message
        self.hint = hint
        full_message = message if hint is None else f"{message} Hint: {hint}"
        super().__init__(full_message)


class SqlFileNotFound(RentalDBError):
    def __init__(self, path: str):
        super().__init__(
            f"SQL file not found: {path}",
            "Ensure the file exists in the package sql directory.",
        )


class QueryNotFound(RentalDBError):
    def __init__(self, name: str):
        super().__init__(
            f"Query not found: {name}",
            "Use one of the predefined query names from all_queries().",
        )
